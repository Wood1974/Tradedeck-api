+async function drawAction(id, status){
+  try {
+    if (status === 'submitted') {
+      var input = document.createElement('input');
+      input.type = 'file';
+      input.accept = 'image/*';
+      input.onchange = async function() {
+        var file = input.files && input.files[0];
+        if (!file) return;
+        var reader = new FileReader();
+        reader.onload = async function() {
+          try {
+            var b64 = reader.result.split(',')[1];
+            await TradeDeckAPI.uploadDrawPhoto(id, b64);
+            await loadData();
+            renderDraws();
+          } catch (e) {
+            alert('Photo upload failed: ' + e.message);
+          }
+        };
+        reader.readAsDataURL(file);
+      };
+      input.click();
+      return;
+    }
+    if (status === 'approved') {
+      await TradeDeckAPI.approveDraw(id);
+    } else if (status === 'disputed') {
+      if (!confirm('Dispute this milestone? This may trigger an escrow refund.')) return;
+      await TradeDeckAPI.refundDraw(id);
+    } else {
+      await sb.from('draws').update({status}).eq('id', id);
+    }
+    await loadData();
+    renderDraws();
+  } catch (e) {
+    alert('Draw action failed: ' + e.message);
+  }
 }
 
