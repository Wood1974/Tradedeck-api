# Required — the service refuses to boot without these
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
# No in-code fallback by design. Generate once and never rotate casually —
# changing it makes every previously stored uploader-IP hash uncorrelatable.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
IP_HASH_SALT=

# Optional
STRIPE_SHIELD_PRICE_ID=
SHIELD_SUCCESS_URL=
SHIELD_CANCEL_URL=
RESEND_API_KEY=
BADGE_WEBHOOK_URL=
BADGE_WEBHOOK_SECRET=

# Tunable
ALLOWED_ORIGINS=http://localhost:3000
ANTHROPIC_MODEL=claude-sonnet-5
SHIELD_BUCKET=shield-photos
MAX_UPLOAD_BYTES=52428800
SIGNED_URL_TTL=900
GPS_TOLERANCE_M=500
MIN_CLEAN_JOBS=3
